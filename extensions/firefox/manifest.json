{
  "manifest_version": 3,
  "name": "NovaLoad Download Bridge",
  "version": "1.0.0",
  "description": "Send Firefox downloads and media links directly to NovaLoad.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@novaload.org",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "scripts": ["../chrome-edge/background.js"]
  },
  "action": {
    "default_popup": "../chrome-edge/popup.html",
    "default_title": "NovaLoad Bridge"
  }
}
