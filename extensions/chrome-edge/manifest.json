{
  "manifest_version": 3,
  "name": "NovaLoad Download Bridge",
  "version": "1.0.0",
  "description": "Send browser downloads and links directly to the NovaLoad desktop download manager.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NovaLoad Bridge"
  }
}
