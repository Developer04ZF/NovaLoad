{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaLoad",
  "version": "1.0.0",
  "identifier": "org.novaload.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NovaLoad — Download smarter. Manage everything.",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3000; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Next-generation open-source desktop download manager",
    "longDescription": "NovaLoad combines multi-connection HTTP/HTTPS acceleration, persistent segmented pause/resume, queue scheduling, browser integration, and optional Gemini AI file organization.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/Developer04ZF/NovaLoad/releases/latest/download/latest.json"
      ]
    }
  }
}
