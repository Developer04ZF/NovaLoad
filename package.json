{
  "name": "novaload",
  "version": "1.0.0",
  "description": "Next-generation open-source desktop download manager with multi-connection acceleration, persistent SQLite queues, integrity verification, browser extensions, and optional Gemini AI organization.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Developer04ZF/NovaLoad",
  "repository": {
    "type": "git",
    "url": "https://github.com/Developer04ZF/NovaLoad.git"
  },
  "bugs": {
    "url": "https://github.com/Developer04ZF/NovaLoad/issues"
  },
  "bin": {
    "novaload": "cli/novaload.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "start:prod": "NODE_ENV=production node build/server.cjs",
    "build": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:extensions": "node scripts/build-extensions.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist build server.js src-tauri/binaries/novaload-server*",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "docs:validate": "node scripts/validate-docs.mjs",
    "validate:versions": "node scripts/validate-versions.mjs",
    "validate:extensions": "node scripts/validate-extensions.mjs",
    "validate:artifacts": "node scripts/validate-artifacts.mjs",
    "validate:release": "node scripts/validate-release.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsdom": "^31.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
